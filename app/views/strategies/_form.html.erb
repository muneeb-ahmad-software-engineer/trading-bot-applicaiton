<%= form_with model: strategy, class: "space-y-8",
      data: { controller: "strategy-category" } do |form| %>
  <% if strategy.errors.any? %>
    <%= render "components/alert", variant: :danger,
               title: "#{pluralize(strategy.errors.count, 'problem')} with this configuration",
               body: strategy.errors.full_messages.to_sentence %>
  <% end %>

  <div class="card">
    <div class="card-body">
      <fieldset class="form-section">
        <legend class="heading-4">Basics</legend>
        <div class="form-section-body">
          <div class="field field-wide">
            <%= label_with_info(form, :name, "Strategy name") %>
            <%= form.text_field :name, class: "input", required: true,
                  "aria-invalid": strategy.errors[:name].any? %>
          </div>

          <div class="field field-wide">
            <%= label_with_info(form, :category, "Strategy type") %>
            <%= form.select :category,
                  [ [ "Grid — a ladder of Buy Stop and Sell Stop orders, closed together at a profit target", "grid" ],
                    [ "Trailing stop — one position per direction, stop follows the price", "trailing" ],
                    [ "Reversal — always in one trade; a trailing opposite order flips it when price turns", "reversal" ] ],
                  {}, class: "select", disabled: strategy.category_locked?,
                  data: { strategy_category_target: "category", action: "change->strategy-category#apply" },
                  "aria-describedby": "category_hint" %>
            <p class="field-hint" id="category_hint">
              A grid rests a ladder of stop orders on both sides of the market and lets price
              fill whichever it reaches; everything that filled is closed together once the
              combined profit reaches the basket take profit, and the ladder is placed again
              after a pause. A trailing strategy takes one position and lets the stop follow
              price in the favourable direction only. A reversal strategy holds one trade at a
              time, with no stop loss: a stop order for the opposite side trails behind it at
              the trailing distance, and when price turns that far the opposite trade takes
              its place. Grid and reversal need a hedging account.
            </p>
          </div>

          <div class="field" data-strategy-category-target="singlePosition">
            <%= label_with_info(form, :direction, "Order direction") %>
            <%= form.select :direction,
                  [ [ "Both directions", "both" ], [ "Buy only", "buy" ], [ "Sell only", "sell" ] ],
                  {}, class: "select", "aria-describedby": "direction_hint" %>
            <p class="field-hint" id="direction_hint">
              Trailing strategies only; a grid's two order counts decide its sides. With
              both directions the robot alternates: after a buy is stopped out the next entry
              is a sell, and the other way round. Buy only or sell only re-enters the same
              way each time.
            </p>
          </div>

          <div class="field">
            <%= label_with_info(form, :symbol, "Symbol") %>
            <%# Rendered through the form builder so the id matches the label's
                `for`. A bare input here left the field with no accessible name.
                Disabled, so it is informational and never submitted. %>
            <%= form.text_field :symbol, value: "XAUUSD", disabled: true, class: "input",
                  "aria-describedby": "symbol_hint" %>
            <p class="field-hint" id="symbol_hint">Gold is the only supported instrument.</p>
          </div>
        </div>
      </fieldset>
    </div>
  </div>

  <div class="card">
    <div class="card-body">
      <fieldset class="form-section">
        <legend class="heading-4">Position sizing</legend>
        <div class="form-section-body">
          <div class="field">
            <%= label_with_info(form, :initial_lot, "Entry lot size") %>
            <%= form.number_field :initial_lot, class: "input-numeric", required: true, step: 0.01, min: 0.01,
                  "aria-describedby": "initial_lot_hint", "aria-invalid": strategy.errors[:initial_lot].any? %>
            <p class="field-hint" id="initial_lot_hint">
              The size of every order. A grid places this lot on each ladder order; a
              trailing or reversal strategy opens this size and nothing more.
            </p>
          </div>

        </div>
      </fieldset>
    </div>
  </div>

  <div class="card" data-strategy-category-target="grid">
    <div class="card-body">
      <fieldset class="form-section">
        <legend class="heading-4">Grid</legend>
        <p class="form-section-description">
          A ladder of resting stop orders: Buy Stops above the market, Sell Stops below it.
          Grid strategies only.
        </p>
        <div class="form-section-body">
          <div class="field">
            <%= label_with_info(form, :grid_spacing_points, "Gap between orders (points)") %>
            <%= form.number_field :grid_spacing_points, class: "input-numeric", min: 1,
                  data: { strategy_category_target: "gridRequired" },
                  "aria-describedby": "spacing_hint", "aria-invalid": strategy.errors[:grid_spacing_points].any? %>
            <p class="field-hint" id="spacing_hint">
              From the market to the first order, and from each order to the next.
              <%= points_as_price_hint(strategy.grid_spacing_points) %>
            </p>
          </div>

          <div class="field">
            <%= label_with_info(form, :grid_buy_orders, "Buy Stop orders") %>
            <%= form.number_field :grid_buy_orders, class: "input-numeric", min: 0,
                  data: { strategy_category_target: "gridRequired" },
                  "aria-invalid": strategy.errors[:grid_buy_orders].any? %>
          </div>

          <div class="field">
            <%= label_with_info(form, :grid_sell_orders, "Sell Stop orders") %>
            <%= form.number_field :grid_sell_orders, class: "input-numeric", min: 0,
                  data: { strategy_category_target: "gridRequired" },
                  "aria-invalid": strategy.errors[:grid_sell_orders].any? %>
          </div>

          <div class="field">
            <%= label_with_info(form, :grid_cycle_pause_seconds, "Pause between cycles (seconds)") %>
            <%= form.number_field :grid_cycle_pause_seconds, class: "input-numeric", min: 1,
                  data: { strategy_category_target: "gridRequired" },
                  "aria-describedby": "pause_hint", "aria-invalid": strategy.errors[:grid_cycle_pause_seconds].any? %>
            <p class="field-hint" id="pause_hint">
              After the basket closes and its remaining orders are cancelled, the robot waits
              this long before placing the next ladder at the new market price.
            </p>
          </div>
        </div>
      </fieldset>
    </div>
  </div>

  <div class="card" data-strategy-category-target="singlePosition">
    <div class="card-body">
      <fieldset class="form-section">
        <legend class="heading-4">Trailing stop</legend>
        <p class="form-section-description">
          A stop that follows the price in the favourable direction and never moves back.
          Required for a trailing strategy. A reversal strategy uses the distance for the
          opposite order that trails its position. A grid has none: its positions are
          closed by the basket take profit.
        </p>
        <div class="form-section-body">
          <div class="field field-wide">
            <%= label_with_info(form, :trailing_stop_points, "Trailing distance (points)") %>
            <%= form.number_field :trailing_stop_points, class: "input-numeric", min: 1,
                  data: { strategy_category_target: "trailingRequired" },
                  "aria-describedby": "trailing_stop_hint",
                  "aria-invalid": strategy.errors[:trailing_stop_points].any? %>
            <p class="field-hint" id="trailing_stop_hint">
              How much of the best price seen you are willing to give back.
              <%= points_as_price_hint(strategy.trailing_stop_points) %>
              With 200 points on a buy: price reaches $355 and the stop sits at $353; price
              reaches $365 and the stop moves to $363. It never moves down.
            </p>
          </div>

          <div class="field">
            <%= label_with_info(form, :trailing_activation_points, "Start trailing after (points)") %>
            <%= form.number_field :trailing_activation_points, class: "input-numeric", min: 1,
                  "aria-describedby": "trailing_activation_hint",
                  "aria-invalid": strategy.errors[:trailing_activation_points].any? %>
            <p class="field-hint" id="trailing_activation_hint">
              Profit the position must reach before the stop is placed at all.
              <%= points_as_price_hint(strategy.trailing_activation_points) %>
              Leave blank to trail from the moment the position opens.
            </p>
          </div>

          <div class="field">
            <%= label_with_info(form, :trailing_step_points, "Minimum step (points)") %>
            <%= form.number_field :trailing_step_points, class: "input-numeric", min: 1,
                  "aria-describedby": "trailing_step_hint",
                  "aria-invalid": strategy.errors[:trailing_step_points].any? %>
            <p class="field-hint" id="trailing_step_hint">
              The stop is only moved when it would improve by at least this much.
              <%= points_as_price_hint(strategy.trailing_step_points) %>
              Leave blank for <%= Strategy::TRAILING_STEP_DEFAULT_POINTS %> points — without a
              step the terminal would be asked to modify the position on almost every tick.
            </p>
          </div>

          <div class="field" data-strategy-category-target="reversal">
            <%= label_with_info(form, :entry_distance_points, "Entry distance (points)") %>
            <%= form.number_field :entry_distance_points, class: "input-numeric", min: 1,
                  "aria-describedby": "entry_distance_hint",
                  "aria-invalid": strategy.errors[:entry_distance_points].any? %>
            <p class="field-hint" id="entry_distance_hint">
              Reversal only. While flat, a Buy Stop rests this far above the price and a
              Sell Stop this far below; the first one reached becomes the trade and the other
              is cancelled. <%= points_as_price_hint(strategy.entry_distance_points) %>
              Leave blank to use the trailing distance.
            </p>
          </div>
        </div>
      </fieldset>
    </div>
  </div>

  <div class="card">
    <div class="card-body">
      <fieldset class="form-section">
        <legend class="heading-4">Basket exits</legend>
        <p class="form-section-description">
          When every open position is closed together, on their combined profit or loss in
          account currency. The take profit is a grid's only exit and is required for it;
          the stop loss is an optional safety net. Leave blank for none.
        </p>
        <div class="form-section-body">
          <div class="field">
            <%= label_with_info(form, :basket_take_profit, "Basket take profit") %>
            <%= form.number_field :basket_take_profit, class: "input-numeric", step: 0.01, min: 0.01,
                  data: { strategy_category_target: "gridRequired" },
                  "aria-invalid": strategy.errors[:basket_take_profit].any? %>
          </div>
          <div class="field">
            <%= label_with_info(form, :basket_stop_loss, "Basket stop loss") %>
            <%= form.number_field :basket_stop_loss, class: "input-numeric", step: 0.01, min: 0,
                  "aria-invalid": strategy.errors[:basket_stop_loss].any? %>
          </div>
        </div>
      </fieldset>
    </div>
  </div>

  <div class="card">
    <div class="card-body">
      <fieldset class="form-section">
        <legend class="heading-4">Risk controls</legend>
        <p class="form-section-description">
          Hard limits the strategy must operate within. These constrain behaviour; they
          do not remove the risk of loss.
        </p>
        <div class="form-section-body">
          <div class="field">
            <%= label_with_info(form, :max_positions, "Maximum positions") %>
            <%= form.number_field :max_positions, class: "input-numeric", required: true, min: 1,
                  "aria-invalid": strategy.errors[:max_positions].any? %>
          </div>
          <div class="field">
            <%= label_with_info(form, :max_exposure_lots, "Maximum exposure (lots)") %>
            <%= form.number_field :max_exposure_lots, class: "input-numeric", required: true, step: 0.01, min: 0.01,
                  "aria-invalid": strategy.errors[:max_exposure_lots].any? %>
          </div>
          <div class="field">
            <%= label_with_info(form, :max_drawdown_percent, "Drawdown protection (%)") %>
            <%= form.number_field :max_drawdown_percent, class: "input-numeric", step: 0.01, min: 0, max: 100,
                  "aria-invalid": strategy.errors[:max_drawdown_percent].any? %>
          </div>
          <div class="field">
            <%= label_with_info(form, :min_margin_level_percent, "Margin protection (min margin level %)") %>
            <%= form.number_field :min_margin_level_percent, class: "input-numeric", step: 0.01, min: 0,
                  "aria-invalid": strategy.errors[:min_margin_level_percent].any? %>
          </div>
          <div class="field field-wide">
            <%= label_with_info(form, :max_spread_points, "Maximum spread (points)") %>
            <%= form.number_field :max_spread_points, class: "input-numeric", min: 1,
                  "aria-describedby": "spread_hint", "aria-invalid": strategy.errors[:max_spread_points].any? %>
            <p class="field-hint" id="spread_hint">New orders are skipped while the spread is wider than this.</p>
          </div>
          <div class="field field-wide">
            <%= label_with_info(form, :max_daily_loss, "Maximum daily loss") %>
            <%= form.number_field :max_daily_loss, class: "input-numeric", step: 0.01, min: 0.01,
                  "aria-describedby": "daily_loss_hint", "aria-invalid": strategy.errors[:max_daily_loss].any? %>
            <p class="field-hint" id="daily_loss_hint">
              In account currency. Once today's closed and open results for this strategy lose this much,
              every position is closed and nothing new opens until the broker's next trading day.
              Leave blank for no daily limit.
            </p>
          </div>
        </div>
      </fieldset>
    </div>
  </div>

  <div class="flex flex-col gap-3 sm:flex-row">
    <%= form.submit(strategy.persisted? ? "Save changes" : "Create strategy", class: "btn btn-primary") %>
    <%= link_to "Cancel", strategy.persisted? ? strategy_path(strategy) : strategies_path, class: "btn btn-ghost" %>
  </div>

  <p class="caption">
    Saving stores configuration only. It does not place any trades.
  </p>
<% end %>
