<% content_for :title, "#{@strategy.name} · #{Rails.application.config.x.product.name}" %>
<% content_for :head do %><meta name="robots" content="noindex"><% end %>

<% actions = capture do %>
  <div class="flex flex-wrap gap-2">
    <% if @strategy.running? %>
      <%= button_to "Stop strategy", stop_strategy_path(@strategy), method: :post,
            class: "btn btn-danger",
            form: { data: { turbo_confirm: "Stop #{@strategy.name}? No new orders will be placed. Positions already open with your broker are not closed." } } %>
    <% else %>
      <%= link_to "Edit", edit_strategy_path(@strategy), class: "btn btn-outline" %>
      <%= button_to "Start strategy", start_strategy_path(@strategy), method: :post,
            class: "btn btn-primary",
            form: { data: { turbo_confirm: "Start #{@strategy.name}? Your Expert Advisor will begin placing orders with your broker according to this configuration." } } %>
    <% end %>
  </div>
<% end %>

<%= render layout: "shared/app_shell",
           locals: { title: @strategy.name, subtitle: "#{@strategy.symbol} · #{@strategy.direction} direction", actions: } do %>

  <div class="mb-4 flex flex-wrap items-center gap-3">
    <%= render "strategies/status_badge", strategy: @strategy,
               executing: terminal_executing?(connection: @connection, instance: @instance) %>
    <% if @strategy.running? && terminal_executing?(connection: @connection, instance: @instance) %>
      <%= render "components/status", state: :live, label: "Running since #{@strategy.started_at.to_fs(:long)}" %>
    <% elsif @strategy.running? %>
      <%# Started, but nothing is executing it. Said next to the badge, because
          a green "running" over a terminal that is down is the question the
          user came to this page with. %>
      <%# Refreshed until it connects, or until it plainly is not going to. %>
      <% refresh_until = terminal_refresh_deadline(strategy: @strategy, instance: @instance) %>
      <span <%= tag.attributes(data: { controller: "auto-refresh", auto_refresh_until_value: refresh_until.iso8601 }) if refresh_until %>>
        <%= render "components/status", state: :warning,
                   label: "Waiting for the terminal — no orders are placed until it connects" %>
      </span>
    <% elsif @strategy.stopped_at %>
      <span class="caption">Stopped <%= @strategy.stopped_at.to_fs(:long) %></span>
    <% end %>
  </div>

  <% if @strategy.running? %>
    <div class="mb-4">
      <%= render "components/alert", variant: :info,
                 title: "Configuration is locked while running",
                 body: "Stop the strategy to change its settings. Editing configuration underneath a live basket would change behaviour mid-flight." %>
    </div>
  <% end %>

  <%#
    Nothing on this page is invented. Every figure below comes from a terminal
    report, so when no terminal is reporting the panel says so rather than
    letting empty tables read as "flat".
  %>
  <div class="mb-4">
    <%= render "strategies/terminal_panel", connection: @connection,
               instance: @instance, credential: @credential, diagnostics: @diagnostics %>
  </div>

  <%# ------------------------------------------------------ Live state %>
  <% if @strategy.running? || @positions.any? || @orders.any? || @closed_count.positive? %>
    <% if @strategy.running? || @positions.any? || @orders.any? %>
    <div class="mb-4 grid gap-4 md:grid-cols-3">
      <div class="card"><div class="card-body">
        <%= render "components/stat", label: "Open positions", value: @positions.size,
                   hint: (@connection&.live? ? nil : "Terminal not reporting") %>
      </div></div>
      <div class="card"><div class="card-body">
        <div class="stat">
          <span class="stat-label">Basket P/L</span>
          <span class="figure-lg <%= profit_tone(@basket_profit) %>">
            <%= @positions.any? ? signed_money(@basket_profit) : "—" %>
            <span class="sr-only"><%= profit_label(@basket_profit) if @positions.any? %></span>
          </span>
          <span class="caption">
            <%= @positions.any? ? "Net of swap and commission" : "No positions reported" %>
          </span>
        </div>
      </div></div>
      <div class="card"><div class="card-body">
        <%= render "components/stat", label: "Pending orders", value: @orders.size %>
      </div></div>
    </div>
    <% end %>

    <% if @strategy.running? %>
      <div class="mb-4">
        <%= render "trading/risk_panel", strategy: @strategy, positions: @positions %>
      </div>
    <% end %>

    <% if @positions.any? %>
      <div class="mb-4">
        <h2 class="heading-4 mb-3">Open positions</h2>
        <%= render "trading/positions_table", positions: @positions, caption: "Open positions" %>
      </div>
    <% end %>

    <% if @orders.any? %>
      <div class="mb-4">
        <h2 class="heading-4 mb-3">Pending orders</h2>
        <%= render "trading/orders_table", orders: @orders %>
      </div>
    <% end %>

    <% if @closed_count.positive? %>
      <p class="body-sm mb-6">
        <%= link_to "View #{pluralize(@closed_count, 'closed position')} in trading history",
              trading_history_path(strategy_id: @strategy.id), class: "inline-block py-1.5 leading-6 text-primary hover:underline" %>
      </p>
    <% end %>
  <% end %>

  <div class="grid gap-4 md:grid-cols-2">
    <div class="card">
      <div class="card-header">
        <h2 class="heading-4"><%= { "grid" => "Grid", "trailing" => "Trailing strategy", "reversal" => "Reversal strategy" }.fetch(@strategy.category) %></h2>
      </div>
      <div class="card-body">
        <dl class="space-y-3">
          <% setup = [
               [ :category, "Strategy type", @strategy.category ],
               [ :direction, "Direction", @strategy.direction ],
               [ :initial_lot, "Entry lot", @strategy.initial_lot ]
             ]
             if @strategy.category_grid?
               setup += [
                 [ :grid_spacing_points, "Grid spacing (points)", @strategy.grid_spacing_points ],
                 [ :grid_levels, "Grid levels", @strategy.grid_levels ],
                 [ :lot_mode, "Lot sizing", @strategy.lot_mode ],
                 [ :lot_multiplier, "Lot multiplier", (@strategy.lot_mode_multiplier? ? @strategy.lot_multiplier : "—") ]
               ]
             end %>
          <%= render "strategies/setting_rows", rows: setup %>
        </dl>
      </div>
    </div>

    <div class="card">
      <div class="card-header"><h2 class="heading-4">Risk controls</h2></div>
      <div class="card-body">
        <dl class="space-y-3">
          <%= render "strategies/setting_rows", rows: [
                [ :max_positions, "Maximum positions", @strategy.max_positions ],
                [ :max_exposure_lots, "Maximum exposure (lots)", @strategy.max_exposure_lots ],
                [ :basket_take_profit, "Basket take profit", @strategy.basket_take_profit || "—" ],
                [ :basket_stop_loss, "Basket stop loss", @strategy.basket_stop_loss || "—" ],
                [ :max_drawdown_percent, "Drawdown protection", (@strategy.max_drawdown_percent ? "#{@strategy.max_drawdown_percent}%" : "—") ],
                [ :min_margin_level_percent, "Minimum margin level", (@strategy.min_margin_level_percent ? "#{@strategy.min_margin_level_percent}%" : "—") ],
                [ :max_spread_points, "Maximum spread (points)", @strategy.max_spread_points || "—" ]
              ] %>
        </dl>
      </div>
    </div>
  </div>

  <div class="card mt-4">
    <div class="card-header"><h2 class="heading-4">Trailing stop</h2></div>
    <div class="card-body">
      <% if @strategy.trailing_enabled? %>
        <dl class="space-y-3">
          <%= render "strategies/setting_rows", rows: [
                [ :trailing_stop_points, "Trailing distance", "#{@strategy.trailing_stop_points} points ($#{number_with_precision(@strategy.trailing_stop_price, precision: 2)})" ],
                [ :trailing_activation_points, "Starts after", (@strategy.trailing_activation_points ? "#{@strategy.trailing_activation_points} points ($#{number_with_precision(@strategy.trailing_activation_price, precision: 2)}) in profit" : "Immediately") ],
                [ :trailing_step_points, "Minimum step", "#{@strategy.trailing_step_points} points ($#{number_with_precision(@strategy.trailing_step_price, precision: 2)})" ]
              ] %>
        </dl>
        <p class="caption mt-3">
          Applied to each position separately, and only ever moved in the favourable
          direction. A stop is held by your broker, so it survives the terminal being
          closed — but it is filled at the market price available, which in a gap may be
          worse than the level shown here.
        </p>
      <% else %>
        <p class="body-sm">
          Not configured. Positions on this strategy are closed by the basket exits only.
        </p>
      <% end %>
    </div>
  </div>

  <div class="card mt-4">
    <div class="card-body">
      <h2 class="heading-4">Maximum theoretical exposure</h2>
      <p class="body-sm mt-2">
        If this strategy opened everything it can, total volume would reach
        <strong class="figure text-text-primary"><%= @strategy.maximum_theoretical_lots %> lots</strong>,
        against a configured ceiling of
        <strong class="figure text-text-primary"><%= @strategy.max_exposure_lots %> lots</strong>.
      </p>
      <p class="caption mt-2">
        This is an arithmetic property of your settings, not a prediction. It says nothing
        about whether the grid will reach its last level, or about profit or loss.
      </p>
    </div>
  </div>

  <% unless @strategy.running? %>
    <div class="mt-8">
      <%= button_to "Delete strategy", strategy_path(@strategy), method: :delete,
            class: "btn btn-ghost text-danger",
            form: { data: { turbo_confirm: "Delete #{@strategy.name}? This cannot be undone." } } %>
    </div>
  <% end %>
<% end %>
