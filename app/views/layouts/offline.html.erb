<%#
  Standalone layout for the offline fallback page.

  Styles are inlined rather than pulled from the compiled stylesheet: this page is
  precached by the service worker and must render correctly even if the digested
  CSS asset is not in the cache. Colours mirror the design system tokens.
%>
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>Offline · <%= Rails.application.config.x.product.name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
    <meta name="theme-color" content="<%= Rails.application.config.x.product.theme_color %>">
    <meta name="robots" content="noindex">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <style>
      :root {
        color-scheme: dark;
        --background: #0B1120;
        --surface: #111C33;
        --border: #1E2D4A;
        --text-primary: #F1F5F9;
        --text-secondary: #94A3B8;
        --primary: #C9A227;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--background);
        color: var(--text-primary);
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
        line-height: 1.6;
      }
      .offline {
        min-height: 100dvh;
        display: grid;
        place-items: center;
        padding: 1.5rem;
      }
      .offline__card {
        width: 100%;
        max-width: 32rem;
        margin-inline: auto;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 0.75rem;
        padding: 2rem;
      }
      .offline__eyebrow {
        margin: 0 0 0.5rem;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--primary);
      }
      .offline__title { margin: 0 0 1rem; font-size: 1.5rem; line-height: 1.3; }
      .offline__body { margin: 0 0 1rem; font-size: 0.95rem; }
      .offline__body--muted { color: var(--text-secondary); }
      .offline__button {
        margin-top: 0.5rem;
        width: 100%;
        padding: 0.75rem 1.25rem;
        font: inherit;
        font-weight: 600;
        color: #0B1120;
        background: var(--primary);
        border: 0;
        border-radius: 0.5rem;
        cursor: pointer;
      }
      .offline__button:hover { background: #B8931F; }
      .offline__button:focus-visible { outline: 2px solid #F1F5F9; outline-offset: 2px; }
      @media (min-width: 640px) { .offline__button { width: auto; } }
    </style>
  </head>
  <body>
    <%= yield %>
  </body>
</html>
