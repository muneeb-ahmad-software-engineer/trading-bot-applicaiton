            </div>
            <ul class="body-sm mt-3 space-y-1.5">
              <li>Accounts and authentication</li>
              <li>Strategy configuration and risk limits</li>
              <li>Start and stop commands</li>
              <li>Monitoring, status and history</li>
            </ul>
          </div>
        </div>

        <div class="flex justify-center" aria-hidden="true">
